# Copia este archivo a .env.local para desarrollo local, y carga las mismas
# llaves como variables de entorno en Vercel para producción. Nunca subas
# un archivo .env.local ni .env con valores reales a GitHub.

# El código que tú (y solo tú) escribes para entrar a la aplicación.
APP_ACCESS_CODE=

# Cualquier texto largo y difícil de adivinar. Se usa para firmar tu sesión.
SESSION_SECRET=

# Panel de Supabase > Project Settings > API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Tu llave de la API de Claude (console.anthropic.com).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
